{
  "name": "induction-motor-calculator",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "description": "Офлайн-калькулятор асинхронного двигателя: ток, мощность, кабель, защита, графики и переходные процессы пуска.",
  "keywords": [
    "induction-motor",
    "async-motor",
    "motor-calculator",
    "cable-sizing",
    "circuit-breaker",
    "electrical-engineering",
    "offline",
    "canvas"
  ],
  "author": "Виктор Ханас <khanas.viktor@gmail.com>",
  "contributors": [
    "DeepSeek (AI assistant)"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "i18n": "node tools/i18n-assemble.cjs",
    "i18n:audit": "node tools/i18n-audit.cjs",
    "test": "node build.mjs && node tests/run.mjs",
    "test:smoke": "node build.mjs && node tests/smoke.mjs",
    "test:static": "node build.mjs && node tests/charts-static.mjs",
    "test:transient": "node build.mjs && node tests/charts-transient.mjs",
    "test:features": "node build.mjs && node tests/features.mjs",
    "test:i18n": "node build.mjs && node tests/i18n.mjs",
    "test:deep": "node build.mjs && node tests/deep.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "build:desktop": "node tools/build-desktop.cjs",
    "desktop": "node tools/build-desktop.cjs && node tools/run-desktop.cjs",
    "desktop:dist": "node tools/build-desktop.cjs && node tools/run-desktop.cjs --dist"
  },
  "devDependencies": {
    "playwright-core": "^1.49.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanasviktor-art/induction-motor-calculator.git"
  },
  "homepage": "https://khanasviktor-art.github.io/induction-motor-calculator/",
  "bugs": {
    "url": "https://github.com/khanasviktor-art/induction-motor-calculator/issues"
  }
